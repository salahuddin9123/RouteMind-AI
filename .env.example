# ===================================================
# RouteMind AI - Production Environment Variables
# ===================================================

# Node Server Port (Render sets this automatically to 10000)
PORT=3001

# Node Environment
NODE_ENV=production

# Google Gemini API Key for AI Assistant (Leave as DEMO_KEY for simulated responses)
AI_API_KEY=DEMO_KEY

# TomTom Traffic API Key (Optional)
TOMTOM_API_KEY=

# Tomorrow.io Flood API Key (Optional)
TOMORROW_IO_API_KEY=

# Google Maps API Key for Live Traffic Layer, 360° Street View & Traffic-Aware Directions
# Enable in Google Cloud Console: Maps JavaScript API, Directions API, Street View Static API
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Frontend API URL (Optional: Leave blank for unified full-stack hosting on same domain)
# VITE_API_URL=https://your-backend.onrender.com/api

